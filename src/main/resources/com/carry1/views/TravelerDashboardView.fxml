<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.carry1.controllers.TravelerDashboardController">
    
    <VBox alignment="CENTER" spacing="20.0">
        <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/></padding>
        <Label text="Traveler Dashboard" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        <Label fx:id="welcomeLabel" text="Welcome!" style="-fx-font-size: 16px;"/>

        <Button text="Withdraw Funds" onAction="#handleWithdrawFunds" prefWidth="200" style="-fx-background-color: #F44336; -fx-text-fill: white; -fx-font-weight: bold;"/>

        <Button text="Live Order Feed" onAction="#handleLiveFeed" prefWidth="200" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Button text="My Deliveries" onAction="#handleMyDeliveries" prefWidth="200"/>

        <Button text="📩 Inbox (Active Chats)" onAction="#handleViewInbox" prefWidth="200" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-weight: bold;"/>

        <Button text="Logout" onAction="#handleLogout" prefWidth="200" style="-fx-background-color: #9E9E9E; -fx-text-fill: white;"/>
    </VBox>

    
    <StackPane fx:id="inboxOverlayPane" visible="false" StackPane.alignment="CENTER" maxHeight="450" maxWidth="450" style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-width: 2; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.6), 15, 0, 0, 0);">
        <VBox fx:id="inboxListPane" VBox.vgrow="ALWAYS">
            <HBox alignment="CENTER_RIGHT" style="-fx-background-color: #FF9800; -fx-padding: 10;">
                <Label text="Inbox (Active Orders)" style="-fx-text-fill: white; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="Close" onAction="#closeInbox" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>
            <ListView fx:id="inboxListView" VBox.vgrow="ALWAYS" style="-fx-padding: 10;"/>
        </VBox>

        <VBox fx:id="inboxChatPane" visible="false" VBox.vgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" style="-fx-background-color: #2196F3; -fx-padding: 10;" spacing="10">
                <Button text="← Back" onAction="#backToInboxList" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Label fx:id="inboxChatHeader" text="Chat" style="-fx-text-fill: white; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
            <ListView fx:id="inboxChatListView" VBox.vgrow="ALWAYS" style="-fx-padding: 10;"/>
            <HBox spacing="5" style="-fx-padding: 10;">
                <TextField fx:id="inboxChatInputField" promptText="Type a message..." HBox.hgrow="ALWAYS"/>
                <Button text="Send" onAction="#sendInboxMessage" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </StackPane>

    
    <VBox fx:id="chatBox" visible="false" StackPane.alignment="BOTTOM_RIGHT" maxHeight="400" maxWidth="300" style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 10; -fx-background-radius: 10;">
        <StackPane.margin><Insets top="0" right="20" bottom="70" left="0"/></StackPane.margin>
        <Label text="Carry1 AI Support" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-padding: 10; -fx-font-weight: bold;" maxWidth="Infinity"/>
        <ListView fx:id="chatListView" VBox.vgrow="ALWAYS"/>
        <HBox spacing="5" style="-fx-padding: 10;">
            <TextField fx:id="chatInputField" promptText="Ask me anything..." HBox.hgrow="ALWAYS"/>
            <Button text="Send" onAction="#handleSendMessage" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
        </HBox>
    </VBox>
    <Button text="💬 Support" onAction="#toggleChatBox" StackPane.alignment="BOTTOM_RIGHT" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-weight: bold; -fx-padding: 10 20;">
        <StackPane.margin><Insets top="0" right="20" bottom="20" left="0"/></StackPane.margin>
    </Button>
</StackPane>
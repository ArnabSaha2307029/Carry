<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.carry1.controllers.RoleSelectionController">

    
    <VBox alignment="CENTER" prefWidth="640.0" style="-fx-background-color: red;" HBox.hgrow="ALWAYS">
        <children>
            <ImageView fitHeight="221.0" fitWidth="389.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../../../Carry.001.png" />
                </image>
            </ImageView>
        </children>
    </VBox>

    
    <VBox alignment="CENTER" prefWidth="640.0" spacing="15.0" style="-fx-background-color: white;" HBox.hgrow="ALWAYS">
        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
        </padding>

        <Label fx:id="titleLabel" text="Select your role:" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <Button text="Customer" onAction="#selectCustomer" prefWidth="220" style="-fx-background-radius: 30; -fx-background-color: #D32F2F; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(211,47,47,0.4), 10, 0, 0, 4); -fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 12 30; -fx-cursor: hand;"/>
        <Button text="Traveler" onAction="#selectTraveler" prefWidth="220" style="-fx-background-radius: 30; -fx-background-color: #D32F2F; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(211,47,47,0.4), 10, 0, 0, 4); -fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 12 30; -fx-cursor: hand;"/>
        <Button fx:id="adminButton" text="Admin" onAction="#selectAdmin" prefWidth="220" style="-fx-background-radius: 30; -fx-background-color: #D32F2F; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(211,47,47,0.4), 10, 0, 0, 4); -fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 12 30; -fx-cursor: hand;"/>

        <Button text="← Back" onAction="#goBack" prefWidth="220" style="-fx-background-color: white; -fx-border-color: #D32F2F; -fx-border-width: 2; -fx-border-radius: 30; -fx-background-radius: 30; -fx-text-fill: #D32F2F; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 8 20; -fx-cursor: hand;"/>
    </VBox>

</HBox>
<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.carry1.controllers.MockWithdrawalController" style="-fx-background-color: #F5F5F5;">

    <VBox fx:id="step1Box" alignment="CENTER" spacing="15.0" maxWidth="450" maxHeight="450" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E0E0E0; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2); -fx-padding: 15;">
        <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/></padding>
        <Label text="Withdraw Funds" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #D32F2F;"/>
        <Label fx:id="currentBalanceLabel" text="Available Balance: 0 TK" style="-fx-text-fill: #D32F2F; -fx-font-weight: bold; -fx-font-size: 14px;"/>
        <Label text="Enter amount to withdraw from your wallet" style="-fx-text-fill: #333333;"/>
        <TextField fx:id="amountField" promptText="Amount (TK)" maxWidth="300" style="-fx-font-size: 16px; -fx-border-color: #EF9A9A; -fx-border-width: 1.5; -fx-border-radius: 5; -fx-background-radius: 5;"/>
        <Label fx:id="errorLabel1" textFill="#D32F2F" wrapText="true" maxWidth="300"/>
        <Button text="Next →" onAction="#goToStep2" prefWidth="300" style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-background-radius: 30; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 25; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(211,47,47,0.4), 8, 0, 0, 3);"/>
        <Button text="Cancel" onAction="#handleCancel" prefWidth="300" style="-fx-background-color: white; -fx-border-color: #D32F2F; -fx-border-width: 2; -fx-border-radius: 30; -fx-background-radius: 30; -fx-text-fill: #D32F2F; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 8 23; -fx-cursor: hand;"/>
    </VBox>

    <VBox fx:id="step2Box" visible="false" alignment="CENTER" spacing="15.0" maxWidth="450" maxHeight="450" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E0E0E0; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2); -fx-padding: 15;">
        <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/></padding>
        <Label text="Withdraw via" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #D32F2F;"/>
        <Label text="Select your withdrawal method" style="-fx-text-fill: #333333;"/>
        <Button text="Mobile Banking" onAction="#selectMobileBanking" prefWidth="300" style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-background-radius: 30; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 25; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(211,47,47,0.4), 8, 0, 0, 3);"/>
        <Button text="Card" onAction="#selectCard" prefWidth="300" style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-background-radius: 30; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 25; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(211,47,47,0.4), 8, 0, 0, 3);"/>
        <Button text="← Back" onAction="#goBackToStep1" prefWidth="300" style="-fx-background-color: white; -fx-border-color: #D32F2F; -fx-border-width: 2; -fx-border-radius: 30; -fx-background-radius: 30; -fx-text-fill: #D32F2F; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 8 23; -fx-cursor: hand;"/>
    </VBox>

    <VBox fx:id="step3Box" visible="false" alignment="CENTER" spacing="15.0" maxWidth="450" maxHeight="450" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E0E0E0; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2); -fx-padding: 15;">
        <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/></padding>
        <Label fx:id="step3Header" text="Withdrawal Details" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #D32F2F;"/>
        <HBox spacing="15" alignment="CENTER">
            <VBox fx:id="method1Box" onMouseClicked="#selectMethod1" alignment="CENTER" style="-fx-border-color: transparent; -fx-background-color: white; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 5; -fx-cursor: hand;">
                <ImageView fx:id="method1Image" fitHeight="40" fitWidth="40" preserveRatio="true"/>
            </VBox>
            <VBox fx:id="method2Box" onMouseClicked="#selectMethod2" alignment="CENTER" style="-fx-border-color: transparent; -fx-background-color: white; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 5; -fx-cursor: hand;">
                <ImageView fx:id="method2Image" fitHeight="40" fitWidth="40" preserveRatio="true"/>
            </VBox>
            <VBox fx:id="method3Box" onMouseClicked="#selectMethod3" alignment="CENTER" style="-fx-border-color: transparent; -fx-background-color: white; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 5; -fx-cursor: hand;">
                <ImageView fx:id="method3Image" fitHeight="40" fitWidth="40" preserveRatio="true"/>
            </VBox>
            <VBox fx:id="method4Box" onMouseClicked="#selectMethod4" alignment="CENTER" style="-fx-border-color: transparent; -fx-background-color: white; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 5; -fx-cursor: hand;">
                <ImageView fx:id="method4Image" fitHeight="40" fitWidth="40" preserveRatio="true"/>
            </VBox>
        </HBox>
        <TextField fx:id="accountNoField" promptText="Account Number" maxWidth="300" style="-fx-font-size: 16px; -fx-border-color: #EF9A9A; -fx-border-width: 1.5; -fx-border-radius: 5; -fx-background-radius: 5;"/>
        <Label fx:id="errorLabel3" textFill="#D32F2F" wrapText="true" maxWidth="300"/>
        <Button text="Next →" onAction="#goToStep4" prefWidth="300" style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-background-radius: 30; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 25; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(211,47,47,0.4), 8, 0, 0, 3);"/>
        <Button text="← Back" onAction="#goBackToStep2" prefWidth="300" style="-fx-background-color: white; -fx-border-color: #D32F2F; -fx-border-width: 2; -fx-border-radius: 30; -fx-background-radius: 30; -fx-text-fill: #D32F2F; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 8 23; -fx-cursor: hand;"/>
    </VBox>

    <VBox fx:id="step4Box" visible="false" alignment="CENTER" spacing="15.0" maxWidth="450" maxHeight="450" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E0E0E0; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2); -fx-padding: 15;">
        <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/></padding>
        <Label text="Security Verification" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #D32F2F;"/>
        <Label text="Enter your account password to authorize transfer" style="-fx-text-fill: #333333;"/>

        <PasswordField fx:id="passwordField" promptText="Your Password" maxWidth="300" style="-fx-font-size: 16px; -fx-border-color: #EF9A9A; -fx-border-width: 1.5; -fx-border-radius: 5; -fx-background-radius: 5;"/>
        <Label fx:id="statusLabel" textFill="#D32F2F" wrapText="true" maxWidth="300" alignment="CENTER" style="-fx-font-weight: bold;"/>

        <Button fx:id="verifyBtn" text="Verify &amp; Proceed" onAction="#verifyPassword" prefWidth="300" style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-background-radius: 30; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 25; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(211,47,47,0.4), 8, 0, 0, 3);"/>
        <Button text="← Back" onAction="#goBackToStep3" prefWidth="300" style="-fx-background-color: white; -fx-border-color: #D32F2F; -fx-border-width: 2; -fx-border-radius: 30; -fx-background-radius: 30; -fx-text-fill: #D32F2F; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 8 23; -fx-cursor: hand;"/>
    </VBox>

    <VBox fx:id="confirmBox" visible="false" alignment="CENTER" spacing="20.0" maxWidth="400" maxHeight="250" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E0E0E0; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2); -fx-padding: 15;">
        <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/></padding>
        <Label text="Confirm Withdrawal" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #D32F2F;"/>
        <Label text="Confirm Cash withdrawal?" style="-fx-text-fill: #333333; -fx-font-size: 16px;"/>
        <HBox spacing="15" alignment="CENTER">
            <Button text="Cancel" onAction="#cancelConfirmation" prefWidth="130" style="-fx-background-color: white; -fx-border-color: #D32F2F; -fx-border-width: 2; -fx-border-radius: 30; -fx-background-radius: 30; -fx-text-fill: #D32F2F; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 8 23; -fx-cursor: hand;"/>
            <Button text="Confirm" onAction="#processFinalWithdrawal" prefWidth="130" style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-background-radius: 30; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 25; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(211,47,47,0.4), 8, 0, 0, 3);"/>
        </HBox>
    </VBox>

</StackPane>

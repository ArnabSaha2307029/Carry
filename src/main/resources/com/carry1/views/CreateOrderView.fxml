<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.carry1.controllers.CreateOrderController" style="-fx-background-color: #F5F5F5;">

    <VBox fx:id="step1Box" alignment="CENTER" spacing="15.0" maxWidth="450" maxHeight="500" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E0E0E0; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2); -fx-padding: 15;">
        <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/></padding>
        <Label text="Step 1: Item Details" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #D32F2F;"/>
                <HBox spacing="10" alignment="CENTER" maxWidth="300">
            <VBox fx:id="typeDocBox" alignment="CENTER" onMouseClicked="#selectTypeDoc" style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10; -fx-cursor: hand;" prefWidth="90">
                <Label text="Documents" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
            </VBox>
            <VBox fx:id="typeFoodBox" alignment="CENTER" onMouseClicked="#selectTypeFood" style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10; -fx-cursor: hand;" prefWidth="90">
                <Label text="Food" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
            </VBox>
            <VBox fx:id="typeOtherBox" alignment="CENTER" onMouseClicked="#selectTypeOther" style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10; -fx-cursor: hand;" prefWidth="90">
                <Label text="Other" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
            </VBox>
        </HBox>
        <TextField style="-fx-border-color: #EF9A9A; -fx-border-width: 1.5; -fx-border-radius: 5; -fx-background-radius: 5;" fx:id="itemNameField" promptText="Product Description" maxWidth="300"/>
        <TextField style="-fx-border-color: #EF9A9A; -fx-border-width: 1.5; -fx-border-radius: 5; -fx-background-radius: 5;" fx:id="itemWeightField" promptText="Product Weight (in KG)" maxWidth="300"/>
        <Label fx:id="errorLabel1" textFill="RED" wrapText="true" maxWidth="300"/>
        <HBox spacing="15" alignment="CENTER" maxWidth="300">
            <Button text="Cancel" onAction="#handleCancel" prefWidth="145" style="-fx-background-color: white; -fx-border-color: #D32F2F; -fx-border-width: 2; -fx-border-radius: 30; -fx-background-radius: 30; -fx-text-fill: #D32F2F; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 8 23; -fx-cursor: hand;"/>
            <Button text="Next →" onAction="#goToStep2" prefWidth="145" style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-background-radius: 30; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 25; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(211,47,47,0.4), 8, 0, 0, 3);"/>
        </HBox>
    </VBox>

    <VBox fx:id="step2Box" visible="false" alignment="CENTER" spacing="15.0" maxWidth="450" maxHeight="500" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E0E0E0; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2); -fx-padding: 15;">
        <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/></padding>
        <Label text="Step 2: Pickup Details" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #D32F2F;"/>
        <TextField style="-fx-border-color: #EF9A9A; -fx-border-width: 1.5; -fx-border-radius: 5; -fx-background-radius: 5;" fx:id="senderNameField" promptText="Sender Name" maxWidth="300"/>
        <TextField style="-fx-border-color: #EF9A9A; -fx-border-width: 1.5; -fx-border-radius: 5; -fx-background-radius: 5;" fx:id="senderPhoneField" promptText="Sender Contact No" maxWidth="300"/>
        <ComboBox fx:id="pickupLocationCombo" promptText="Select Pickup Location" prefWidth="300"/>
        <TextField style="-fx-border-color: #EF9A9A; -fx-border-width: 1.5; -fx-border-radius: 5; -fx-background-radius: 5;" fx:id="pickupInfoField" promptText="Additional Pickup Info" maxWidth="300"/>
        <Label fx:id="errorLabel2" textFill="RED" wrapText="true" maxWidth="300"/>
        <HBox spacing="15" alignment="CENTER" maxWidth="300">
            <Button text="← Back" onAction="#goToStep1" prefWidth="145" style="-fx-background-color: white; -fx-border-color: #D32F2F; -fx-border-width: 2; -fx-border-radius: 30; -fx-background-radius: 30; -fx-text-fill: #D32F2F; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 8 23; -fx-cursor: hand;"/>
            <Button text="Next →" onAction="#goToStep3" prefWidth="145" style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-background-radius: 30; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 25; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(211,47,47,0.4), 8, 0, 0, 3);"/>
        </HBox>
    </VBox>

    <VBox fx:id="step3Box" visible="false" alignment="CENTER" spacing="15.0" maxWidth="450" maxHeight="500" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E0E0E0; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2); -fx-padding: 15;">
        <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/></padding>
        <Label text="Step 3: Delivery Details" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #D32F2F;"/>
        <TextField style="-fx-border-color: #EF9A9A; -fx-border-width: 1.5; -fx-border-radius: 5; -fx-background-radius: 5;" fx:id="receiverNameField" promptText="Receiver Name" maxWidth="300"/>
        <TextField style="-fx-border-color: #EF9A9A; -fx-border-width: 1.5; -fx-border-radius: 5; -fx-background-radius: 5;" fx:id="receiverPhoneField" promptText="Receiver Contact No" maxWidth="300"/>
        <ComboBox fx:id="dropoffLocationCombo" promptText="Select Delivery Location" prefWidth="300"/>
        <TextField style="-fx-border-color: #EF9A9A; -fx-border-width: 1.5; -fx-border-radius: 5; -fx-background-radius: 5;" fx:id="dropoffInfoField" promptText="Additional Delivery Info" maxWidth="300"/>
        <Label fx:id="errorLabel3" textFill="RED" wrapText="true" maxWidth="300"/>
        <HBox spacing="15" alignment="CENTER" maxWidth="300">
            <Button text="← Back" onAction="#goToStep2" prefWidth="145" style="-fx-background-color: white; -fx-border-color: #D32F2F; -fx-border-width: 2; -fx-border-radius: 30; -fx-background-radius: 30; -fx-text-fill: #D32F2F; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 8 23; -fx-cursor: hand;"/>
            <Button text="Calculate Fee →" onAction="#calculateAndGoToStep4" prefWidth="145" style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-background-radius: 30; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 25; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(211,47,47,0.4), 8, 0, 0, 3);"/>
        </HBox>
    </VBox>

    <VBox fx:id="step4Box" visible="false" alignment="CENTER" spacing="15.0" maxWidth="450" maxHeight="500" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E0E0E0; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2); -fx-padding: 15;">
        <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/></padding>
        <Label text="Review &amp; Confirm" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #D32F2F;"/>

        <VBox fx:id="loadingBox" alignment="CENTER" spacing="10" visible="false" managed="false">
            <ProgressIndicator/>
            <Label text="Validating map locations and calculating distance..."/>
        </VBox>

        <VBox fx:id="summaryBox" alignment="CENTER" spacing="10" style="-fx-background-color: #FAFAFA; -fx-padding: 20; -fx-background-radius: 8;" maxWidth="350">
            <Label fx:id="distanceLabel" text="Distance: --" style="-fx-font-size: 14px; -fx-text-fill: #333333;"/>
            <Label fx:id="weightLabel" text="Weight: --" style="-fx-font-size: 14px; -fx-text-fill: #333333;"/>
            <Label fx:id="feeLabel" text="Total Delivery Fee: -- TK" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #D32F2F;"/>
            <Label fx:id="balanceWarningLabel" textFill="RED" wrapText="true"/>
        </VBox>

        <Label fx:id="errorLabel4" textFill="RED" wrapText="true" maxWidth="300" alignment="CENTER"/>

        <HBox spacing="15" alignment="CENTER" maxWidth="300">
            <Button fx:id="backBtn4" text="← Edit Details" onAction="#goToStep3" prefWidth="145" style="-fx-background-color: white; -fx-border-color: #D32F2F; -fx-border-width: 2; -fx-border-radius: 30; -fx-background-radius: 30; -fx-text-fill: #D32F2F; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 8 23; -fx-cursor: hand;"/>
            <Button fx:id="confirmBtn" text="Confirm Order" onAction="#handleConfirmOrder" prefWidth="145" style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-background-radius: 30; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 25; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(211,47,47,0.4), 8, 0, 0, 3);"/>
        </HBox>
    </VBox>
</StackPane>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.carry1.controllers.AdminDashboardController">
    <HBox style="-fx-background-color: #212121; -fx-padding: 15;" alignment="CENTER_LEFT">
        <Label text="Carry1 Admin Control Panel" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button text="Logout" onAction="#handleLogout" style="-fx-background-color: #F44336; -fx-text-fill: white;"/>
    </HBox>

    <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
        <!-- GLOBAL LEDGER TAB -->
        <Tab text="Global Ledger &amp; Stats">
            <VBox alignment="CENTER" spacing="20" style="-fx-padding: 40;">
                <HBox spacing="20" alignment="CENTER">
                    <VBox style="-fx-background-color: #E3F2FD; -fx-padding: 30; -fx-background-radius: 10;" alignment="CENTER">
                        <Label text="Active Orders" style="-fx-font-size: 16px;"/>
                        <Label fx:id="activeOrdersLabel" text="0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #1976D2;"/>
                    </VBox>
                    <VBox style="-fx-background-color: #E8F5E9; -fx-padding: 30; -fx-background-radius: 10;" alignment="CENTER">
                        <Label text="Delivered Orders" style="-fx-font-size: 16px;"/>
                        <Label fx:id="deliveredOrdersLabel" text="0" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #388E3C;"/>
                    </VBox>
                </HBox>
                <HBox spacing="20" alignment="CENTER">
                    <VBox style="-fx-background-color: #FFF3E0; -fx-padding: 30; -fx-background-radius: 10;" alignment="CENTER">
                        <Label text="Total System Escrow &amp; Wallets" style="-fx-font-size: 16px;"/>
                        <Label fx:id="systemMoneyLabel" text="0 TK" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #F57C00;"/>
                    </VBox>
                    <VBox style="-fx-background-color: #FCE4EC; -fx-padding: 30; -fx-background-radius: 10;" alignment="CENTER">
                        <Label text="Admin Carry Wallet (Profit)" style="-fx-font-size: 16px;"/>
                        <Label fx:id="adminProfitLabel" text="0 TK" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #C2185B;"/>
                    </VBox>
                </HBox>
                <Button text="Refresh Stats" onAction="#loadStats" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 16px;"/>
            </VBox>
        </Tab>

        <!-- USER MODERATION TAB -->
        <Tab text="User Moderation">
            <VBox spacing="10" style="-fx-padding: 15;">
                <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="uColId" text="User ID" prefWidth="120"/>
                        <TableColumn fx:id="uColName" text="Name" prefWidth="150"/>
                        <TableColumn fx:id="uColRole" text="Role" prefWidth="100"/>
                        <TableColumn fx:id="uColBalance" text="Balance" prefWidth="100"/>
                        <TableColumn fx:id="uColStatus" text="Status" prefWidth="100"/>
                        <TableColumn fx:id="uColAction" text="Actions" prefWidth="250"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <!-- ORDER OVERRIDE TAB -->
        <Tab text="Disputes &amp; Orders">
            <VBox spacing="10" style="-fx-padding: 15;">
                <TableView fx:id="orderTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="oColId" text="Order ID" prefWidth="120"/>
                        <TableColumn fx:id="oColCust" text="Customer" prefWidth="120"/>
                        <TableColumn fx:id="oColTrav" text="Traveler" prefWidth="120"/>
                        <TableColumn fx:id="oColStatus" text="Status" prefWidth="120"/>
                        <TableColumn fx:id="oColAction" text="Admin Actions" prefWidth="250"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>
    </TabPane>
</VBox>